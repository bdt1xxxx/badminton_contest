/**app.wxss**/
page {
  min-height: 100%;
  background: #f4f7f5;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f4f7f5;
}

button {
  margin: 0;
  padding: 0;
  line-height: normal;
}

button::after {
  border: none;
}
