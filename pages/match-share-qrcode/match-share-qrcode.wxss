.qrcode-page {
  min-height: 100vh;
  background: #f4f7f5;
}

.page-content {
  padding: 24rpx 28rpx 40rpx;
}

.header-card,
.qrcode-card {
  background: #ffffff;
  border: 1rpx solid #e5efe8;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.header-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 850;
  color: #0f172a;
}

.header-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.qrcode-card {
  min-height: 580rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
}

.qrcode-image {
  width: 480rpx;
  height: 480rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.state-text {
  font-size: 28rpx;
  color: #64748b;
}

.state-text.error {
  color: #b91c1c;
}

.tip-text {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
}

.manual-share-box {
  width: 100%;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.manual-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.manual-value {
  display: block;
  margin-top: 6rpx;
  word-break: break-all;
  font-size: 24rpx;
  color: #0f172a;
}

.action-row {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: #16a34a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.secondary {
  background: #e2e8f0;
  color: #334155;
}
