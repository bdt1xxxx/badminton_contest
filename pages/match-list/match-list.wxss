.container {
  padding: 0 !important;
  margin: 0 !important;
  background-color: #f5f5f5;
  min-height: 100vh;
  height: auto !important;
  display: block !important;
  flex-direction: unset !important;
  align-items: unset !important;
  justify-content: unset !important;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 20rpx 0;
  background-color: white;
  margin: 0 !important;
  margin-bottom: 0 !important;
  width: 100%;
  box-sizing: border-box;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin: 0 !important;
  padding: 0 !important;
}

.tabs {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 25rpx 0;
  position: relative;
}

.tab-item.active {
  background-color: #3cc51f;
}

.tab-item.active .tab-text {
  color: #fff;
}

.tab-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.matches-list {
  padding: 0 !important;
  margin: 0 !important;
  margin-top: 0 !important;
}

.match-item {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 0 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

.match-item:first-child {
  margin-top: 0 !important;
  margin-bottom: 20rpx;
}

.match-info {
  padding: 20rpx;
  position: relative;
}

.match-status-top {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

.match-status {
  padding: 8rpx 20rpx;
  background-color: #f0f0f0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #e0e0e0;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 15rpx;
  background-color: #f8f8f8;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
}

.info-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

.match-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  justify-content: center;
  align-items: center;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.view-btn {
  background: #007aff;
  color: white;
}

.start-btn {
  background-color: #3cc51f;
  color: #fff;
}

.end-btn {
  background-color: #ff9500;
  color: #fff;
}

.delete-btn {
  background: #ff3b30;
  color: white;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #ccc;
} 