.container {
  padding: 0;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.profile-header {
  background-color: #fff;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.profile-content {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid #3cc51f;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.get-userinfo-btn {
  background-color: #3cc51f;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  align-self: flex-start;
}

.action-section {
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  width: 100%;
  height: 80rpx;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.export-btn {
  background-color: #007aff;
  color: #fff;
}

.import-btn {
  background-color: #28a745;
  color: #fff;
}

.clear-btn {
  background-color: #ff4757;
  color: #fff;
} 