<view class="container">
  <view class="profile-header">
    <view class="profile-content">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname}}</text>
        
        <!-- 当用户未授权时显示获取用户信息按钮 -->
        <button wx:if="{{!hasUserInfo}}" 
                class="get-userinfo-btn" 
                bindtap="getUserProfile">
          获取微信头像和昵称
        </button>
      </view>
    </view>
  </view>

  <view class="action-section">
    <button class="action-btn export-btn" bindtap="exportData">导出数据</button>
    <button class="action-btn import-btn" bindtap="importData">导入数据</button>
    <button class="action-btn clear-btn" bindtap="clearData">清除数据</button>
  </view>
</view> 