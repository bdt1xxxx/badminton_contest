.create-page {
  min-height: 100vh;
  background: #f4f7f5;
  padding-bottom: 132rpx;
}

.page-content {
  padding: 28rpx 28rpx 0;
}

.hero-section {
  padding: 12rpx 4rpx 24rpx;
}

.hero-title,
.hero-subtitle {
  display: block;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #102318;
  line-height: 1.15;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.section-card {
  background: #ffffff;
  border: 1rpx solid #e5efe8;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.section-meta {
  font-size: 24rpx;
  font-weight: 700;
  color: #16a34a;
}

.type-segment {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border-radius: 999rpx;
  background: #e8f2eb;
}

.segment-item {
  height: 68rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #64748b;
}

.segment-item.active {
  background: #ffffff;
  color: #166534;
  box-shadow: 0 4rpx 12rpx rgba(22, 101, 52, 0.12);
}

.form-item {
  margin-bottom: 22rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}

.input,
.picker {
  height: 84rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce8df;
  border-radius: 20rpx;
  background: #f8fafc;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.picker {
  line-height: 84rpx;
}

.player-row {
  display: grid;
  grid-template-columns: 52rpx 1fr 142rpx;
  gap: 16rpx;
  align-items: center;
  min-height: 82rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef4f0;
}

.player-row:last-child {
  border-bottom: none;
}

.player-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.player-input {
  height: 72rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.level-pill {
  min-height: 58rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.submit-section {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(244, 247, 245, 0.94);
  border-top: 1rpx solid #e5efe8;
  box-sizing: border-box;
}

.submit-btn {
  height: 92rpx;
  border-radius: 24rpx;
  background: #16a34a;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(22, 163, 74, 0.22);
}

.confirm-dialog {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

.dialog-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(15, 23, 42, 0.48);
}

.dialog-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 84%;
  max-width: 620rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.2);
  overflow: hidden;
}

.dialog-header {
  padding: 34rpx 30rpx 18rpx;
  text-align: center;
  border-bottom: 1rpx solid #edf2ef;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.dialog-body {
  padding: 26rpx;
}

.dialog-item {
  margin-bottom: 24rpx;
}

.dialog-item:last-child {
  margin-bottom: 0;
}

.dialog-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.dialog-picker {
  width: 100%;
}

.picker-display {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #dce8df;
  border-radius: 18rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #f8fafc;
  box-sizing: border-box;
  line-height: 80rpx;
  color: #0f172a;
  text-align: center;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.radio {
  transform: scale(1.1);
}

.radio-label {
  font-size: 26rpx;
  color: #0f172a;
}

.shuffle-label {
  display: flex;
  align-items: center;
}

.shuffle-text {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.dialog-footer {
  display: flex;
  border-top: 1rpx solid #edf2ef;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.cancel-btn {
  background-color: #ffffff;
  color: #64748b;
  border-right: 1rpx solid #edf2ef;
}

.confirm-btn {
  background-color: #16a34a;
  color: #ffffff;
}

.progress-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.progress-content {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 84%;
  max-width: 620rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.2);
}

.progress-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #17212f;
}

.progress-body {
  text-align: center;
}

.algorithm-info {
  margin-bottom: 20rpx;
}

.algorithm-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #16a34a;
  margin-bottom: 8rpx;
}

.algorithm-phase {
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background-color: #e5efe8;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #16a34a, #14b8a6);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-percentage {
  font-size: 26rpx;
  font-weight: 800;
  color: #16a34a;
}

.progress-steps {
  font-size: 22rpx;
  color: #64748b;
}
