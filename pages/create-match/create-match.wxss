.container {
  padding: 0;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 20rpx 0;
  background-color: white;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.main-panel {
  background-color: #fff;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-section {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
  line-height: 80rpx;
  color: #333;
}

.players-section {
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.shuffle-row {
  margin-top: 20rpx;
  margin-bottom: 0;
}

.shuffle-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.shuffle-text {
  margin-left: 12rpx;
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.players-panel {
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.panel-header {
  display: flex;
  background-color: #f8f8f8;
  border-bottom: 1rpx solid #e0e0e0;
  width: 100%;
  box-sizing: border-box;
}

.header-nickname {
  flex: 1;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.header-level {
  flex: 1;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.panel-body {
  background-color: #fff;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.input-row {
  display: flex;
  margin-bottom: 20rpx;
  gap: 20rpx;
  width: 100%;
}

.input-row:last-child {
  margin-bottom: 0;
}

.input-group {
  flex: 1;
  display: flex;
  gap: 15rpx;
  align-items: center;
  width: 100%;
}

.nickname-input {
  flex: 1;
  height: 70rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
}

.level-picker {
  flex: 1;
}

.level-display {
  height: 70rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
  line-height: 70rpx;
  color: #333;
  text-align: center;
}

.submit-section {
  padding: 20rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background-color: #3cc51f;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  background-color: #2e9e16;
}

/* 确认对话框样式 */
.confirm-dialog {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
}

.dialog-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.dialog-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
}

.dialog-header {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.dialog-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.dialog-body {
  padding: 30rpx;
}

.dialog-item {
  margin-bottom: 30rpx;
}

.dialog-item:last-child {
  margin-bottom: 0;
}

.dialog-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.dialog-picker {
  width: 100%;
}

.picker-display {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #fff;
  box-sizing: border-box;
  line-height: 80rpx;
  color: #333;
  text-align: center;
}

.radio-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.radio {
  transform: scale(1.2);
}

.radio-label {
  font-size: 28rpx;
  color: #333;
}

.dialog-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.dialog-btn {
  flex: 1;
  height: 90rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 90rpx;
}

.cancel-btn {
  background-color: #fff;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.confirm-btn {
  background-color: #007aff;
  color: #fff;
}

/* 进度显示组件样式 */
.progress-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.progress-content {
  background-color: white;
  border-radius: 16rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.progress-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.progress-body {
  text-align: center;
}

.algorithm-info {
  margin-bottom: 25rpx;
}

.algorithm-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #007aff;
  margin-bottom: 10rpx;
}

.algorithm-phase {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.progress-bar {
  width: 100%;
  height: 20rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #007aff, #5ac8fa);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-percentage {
  font-size: 28rpx;
  font-weight: bold;
  color: #007aff;
}

.progress-steps {
  font-size: 24rpx;
  color: #666;
} 